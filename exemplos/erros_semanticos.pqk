// Programa sintaticamente correto, mas com erros semanticos de proposito
program ErrosSemanticos;
const
  LIMITE = 10;
  ERRADA : integer = 2.5;
var
  x, y : integer;
  x : real;
  media : real;
  nome : string;
  letra : char;
  v : integer[0];
  w : integer[3];

procedure imprimir(valor : integer);
begin
  writeln(valor)
end;

function dobro(n : integer) : integer;
begin
  y := n * 2
end;

begin
  x := 3.7;
  LIMITE := 20;
  z := 1;
  nome := 10;
  letra := 'abc';
  media := nome + 1;
  if x then
    x := 1;
  while (x > 1) E nome do
    x := x - 1;
  imprimir(1, 2);
  imprimir('oi');
  x := imprimir(5);
  y := dobro;
  dobro := 4;
  x := x(1);
  w[1.5] := 2;
  x[1] := 3;
  for media := 1 to 10 do
    x := x + 1;
  break;
  read(LIMITE);
  writeln(w);
  ErrosSemanticos := 1;
end.
